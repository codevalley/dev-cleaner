{
  "name": "dev-cleaner",
  "version": "0.1.0",
  "description": "Interactive TUI that finds regenerable build artifacts across a projects directory and moves them to the Trash.",
  "keywords": [
    "cleanup",
    "disk-space",
    "node_modules",
    "build-artifacts",
    "tui"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "dev-cleaner": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "ink": "^5.0.1",
    "react": "^18.3.1",
    "trash": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "ink-testing-library": "^4.0.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
